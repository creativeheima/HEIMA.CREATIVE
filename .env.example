# ── Website ──────────────────────────────────────────────
# URL produksi (sitemap, canonical, Open Graph), mis. https://heima-creative.vercel.app
NEXT_PUBLIC_SITE_URL=https://heimacreative.com
# Opsional: webhook (Slack, Make, Zapier, dsb.) yang menerima submit form kontak
CONTACT_WEBHOOK_URL=

# ── Sanity CMS ───────────────────────────────────────────
# Kosongkan PROJECT_ID → website memakai konten bawaan di src/data
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Rahasia bersama untuk webhook /api/revalidate (string acak panjang)
SANITY_REVALIDATE_SECRET=
# Hanya untuk `npm run sanity:seed` (token Editor). JANGAN diisi di Vercel.
SANITY_API_WRITE_TOKEN=
